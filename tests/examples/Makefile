ifndef config
  config=debug
endif

ifndef verbose
  SILENT = @
endif

ifeq ($(config),debug)
  ExampleGameTests_config = debug

else ifeq ($(config),release)
  ExampleGameTests_config = release

else
  $(error "invalid configuration $(config)")
endif

PROJECTS := ExampleGameTests

.PHONY: all clean help $(PROJECTS) 

all: $(PROJECTS)

ExampleGameTests:
ifneq (,$(ExampleGameTests_config))
	@echo "==== Building ExampleGameTests ($(ExampleGameTests_config)) ===="
	@${MAKE} --no-print-directory -C . -f ExampleGameTests.make config=$(ExampleGameTests_config)
endif

clean:
	@${MAKE} --no-print-directory -C . -f ExampleGameTests.make clean

help:
	@echo "Usage: make [config=name] [target]"
	@echo ""
	@echo "CONFIGURATIONS:"
	@echo "  debug"
	@echo "  release"
	@echo ""
	@echo "TARGETS:"
	@echo "   all (default)"
	@echo "   clean"
	@echo "   ExampleGameTests"
	@echo ""
	@echo "For more information, see https://github.com/premake/premake-core/wiki"