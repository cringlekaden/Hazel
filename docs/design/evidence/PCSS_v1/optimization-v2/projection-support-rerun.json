{
  "release-planes": {
    "command": [
      "python3",
      "scripts/macos/directional_pcss.py",
      "--config",
      "Release",
      "--resources",
      "<repo>/Hazel/Resources",
      "--output",
      "<repo>/build/pcss-v1/final-support/release-planes"
    ],
    "exitCode": 0
  },
  "release-strips": {
    "command": [
      "python3",
      "scripts/macos/directional_pcss.py",
      "--config",
      "Release",
      "--resources",
      "<repo>/Hazel/Resources",
      "--output",
      "<repo>/build/pcss-v1/final-support/release-strips",
      "--strips"
    ],
    "exitCode": 0,
    "backends": {
      "metal": "PASS scoped thin/layered depth-grid",
      "opengl": "PASS scoped thin/layered depth-grid"
    }
  },
