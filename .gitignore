# Build output
bin/
bin-int/
__pycache__/
/docs/migration/evidence/*.log

# Premake generated GNU Make files
/Makefile
/Hazel/Makefile
/Nutella/Makefile
/Hazel/vendor/Glad/Makefile
/build/

# Compilation database generated by Bear
compile_commands.json

# VS generated files
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# Object and library files
*.o
*.so
*.a

# VS Code local config
.vscode/
# Project-managed generated files
/examples/*/Assets/Scripts/Binaries/
/examples/*/Assets/Scripts/Intermediates/
/examples/*/Assets/Scripts/Makefile
/examples/*/Assets/Scripts/*.make
/examples/*/Assets/Scripts/*.csproj
/examples/*/Assets/Scripts/*.csproj.user
/Hazelnut/Resources/Scripts/*.dll
/Hazelnut/Resources/Scripts/*.pdb
/dist/

# Retained local diagnostic output from earlier development
/Hazelnut/HazelProfile-*.json
/Hazelnut/assets/cache/

# Protect against older test workspace generation beside source.
/tests/examples/Makefile
/tests/examples/*.make
/tests/examples/*.csproj
